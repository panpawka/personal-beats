datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: This project started on SQLite, so enum-like columns and array
// columns are stored as String / JSON-string. Valid values are enforced
// at the app layer (Zod in src/shared/types.ts). Now on Postgres but the
// JSON-string shape is left intact — converting to native enums + String[]
// is a separate refactor (touches every read/write site + Zod) and is not
// required for Phase 11 (jobs).

// Wasp fills in auth fields automatically.
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email                     String          @unique
  username                  String          @unique
  lastActiveTimestamp       DateTime        @default(now())
  isAdmin                   Boolean         @default(false)
  name                      String?

  paymentProcessorUserId    String?         @unique
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted', 'not_subscribed', 'disabled'
  subscriptionPlan          String?         // 'mini', 'premium'
  
  datePaid                  DateTime?
  subscriptionEndDate       DateTime?

  beats Beat[]
}

model Beat {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                 String   @unique
  title                String
  brief                String

  // BeatStatus: DRAFT | DESIGNING | AWAITING_CLARIFICATION | SCOUTING | ACTIVE | PAUSED | FAILED
  status               String   @default("DRAFT")
  // CadenceType: TIME_BASED | ON_DEMAND
  cadenceType          String
  cronExpression       String?
  timezone             String   @default("Europe/Warsaw")
  // Depth: BRIEF | STANDARD | DEEP
  depth                String   @default("STANDARD")
  outputLanguage       String   @default("en")

  specMemoryStoreId    String?
  historyMemoryStoreId String?

  // Legacy per-phase session id columns — superseded by currentSessionId +
  // currentPhase below. Retained so the migration is additive (no data
  // loss). Not read or written by the new driver.
  designSessionId      String?
  scoutSessionId       String?
  editorSessionId      String?

  // Active CMA session + phase. Replaces per-phase id columns. Only one
  // phase runs at a time per beat (singletonKey on driveAgentJob).
  // AgentPhase: DESIGNER | SCOUT | EDITOR | RELEVANCE
  currentPhase         String?
  currentSessionId     String?
  // CMA event-stream cursor for the active session. driveAgentJob re-enqueues
  // between ticks; the cursor prevents re-processing already-ingested events.
  lastEventId          String?
  // Consecutive reenqueues without progress on the current phase. Reset on
  // kickoff, phase_done/failed/waiting_for_user, and whenever a tick ingests
  // fresh events. Guard against zombie sessions that never emit a terminal
  // signal (e.g. server crashed between advancing the event cursor and
  // handling a session.status_idle).
  reenqueueCount       Int      @default(0)

  summary              String?
  // JSON array of defaults applied by Beat Designer
  defaultsApplied      String   @default("[]")

  sourceCount          Int?
  // coverage assessment: healthy | thin | sparse
  coverageAssessment   String?
  coverageNote         String?

  // JSON: { questions: string[], sessionId: string, reasoning: string }
  pendingClarification String?

  // Phase 11 sweeper bookkeeping: last time scheduleSweeperJob fired this
  // beat's generateIssueJob. Compared against cron-parser.next(currentDate=lastScheduledAt)
  // to decide if a new firing is due. On-demand runs do NOT bump this — only
  // the cron sweeper does.
  lastScheduledAt      DateTime?


  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  issues               Issue[]
  agentEvents          AgentEvent[]
  agentMessages        AgentMessage[]

  @@index([userId, status])
}

// Durable event log for CMA sessions. One row per ingested event from
// client.beta.sessions.events.list. Unique on (sessionId, eventId) dedups
// re-polls. driveAgentJob writes; UI polls via getAgentEvents.
model AgentEvent {
  id         String   @id @default(uuid())
  beatId     String
  beat       Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  sessionId  String
  // AgentPhase: DESIGNER | SCOUT | EDITOR | RELEVANCE
  phase      String
  // CMA event id. Null for synthetic server-side markers (phase.started, phase.failed).
  eventId    String?
  // CMA event type (e.g. agent.message, session.status_idle, agent.custom_tool_use)
  // or synthetic (phase.started, phase.failed).
  type       String
  // Normalized payload: { text?, toolName?, toolInput?, stopReason?, error?, summary? }.
  // We do NOT store the raw CMA payload (can be large + contains deltas).
  payload    String
  occurredAt DateTime @default(now())

  @@unique([sessionId, eventId])
  @@index([beatId, occurredAt])
}

// Queue of user-originated messages to inject into a running CMA session.
// submitClarification writes; driveAgentJob drains + marks consumed.
model AgentMessage {
  id         String    @id @default(uuid())
  beatId     String
  beat       Beat      @relation(fields: [beatId], references: [id], onDelete: Cascade)
  sessionId  String
  // MessageKind: CLARIFICATION_REPLY | USER_FOLLOWUP
  kind       String
  text       String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([sessionId, consumedAt])
}

model Issue {
  id           String      @id @default(uuid())
  beatId       String
  beat         Beat        @relation(fields: [beatId], references: [id], onDelete: Cascade)
  sessionId    String
  publishedAt  DateTime    @default(now())
  issueDate    DateTime
  subject      String
  dek          String
  coverageNote String?
  htmlBody     String
  plainBody    String
  // EmailStatus: PENDING | SENT | FAILED
  emailStatus  String      @default("PENDING")
  emailSentAt  DateTime?
  items        IssueItem[]

  @@index([beatId, publishedAt])
}

model IssueItem {
  id                  String    @id @default(uuid())
  issueId             String
  issue               Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  orderIndex          Int
  headline            String
  summary             String
  whyItMatters        String?
  primarySourceUrl    String
  // JSON array of secondary URLs
  secondarySourceUrls String    @default("[]")
  // JSON array of tag strings
  tags                String    @default("[]")
  fingerprint         String
  // Feedback: POSITIVE | NEGATIVE | (null = no feedback)
  feedback            String?
  feedbackAt          DateTime?
  feedbackToken       String?   @unique

  @@index([issueId, orderIndex])
}
